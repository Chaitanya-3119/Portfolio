# Canonical site URL (used by metadata, OG image, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: MongoDB. Leave MONGODB_URI empty to keep using src/lib/fallback-data.ts
MONGODB_URI=

# Admin panel (/admin) and seed route
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Instant Notification Channels (When someone contacts you)
# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook
DISCORD_WEBHOOK_URL=

# Gmail SMTP Notification (Receive alerts in your inbox using Gmail App Password)
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL=

# Resend Email (alternative API)
RESEND_API_KEY=

# WhatsApp Option 1: Free CallMeBot API
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# SMS (Text) & WhatsApp Option 2: Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
NOTIFICATION_PHONE_NUMBER=
