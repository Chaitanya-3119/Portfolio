# Canonical site URL (used by metadata, OG image, sitemap, robots)
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: MongoDB. Leave MONGODB_URI empty to keep using src/lib/fallback-data.ts
MONGODB_URI=

# Admin panel (/admin) and seed route
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
